[Desktop Entry]
Name=Friday 2PM Countdown
Comment=Shows minutes until 2 PM on Fridays, then a beer emoji
Exec=cosmic-applet-friday-countdown
Icon=dk.bjarkebjarke.CosmicAppletFridayCountdown
Terminal=false
Type=Application
Categories=COSMIC;
NoDisplay=true
X-CosmicApplet=true
StartupWMClass=dk.bjarkebjarke.CosmicAppletFridayCountdown
